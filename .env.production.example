MYSQL_DATABASE=tanish_wordpress
MYSQL_USER=tanish_wp
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0
WORDPRESS_URL=https://tanish.example.com

# Caddy
CADDY_DOMAIN=tanish.example.com
CADDY_EMAIL=admin@example.com

# --- Correo SMTP (producción: Brevo) ---
# WordPress lee estas variables con getenv() desde el contenedor.
# En local se usa Mailpit (SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_AUTH=0,
# SMTP_SECURE vacío). En producción, los valores de Brevo son:
#   Host: smtp-relay.brevo.com · Puerto: 587 · STARTTLS · Auth: usuario/contraseña SMTP
# SMTP_USER y SMTP_PASSWORD se obtienen en Brevo > SMTP & API > SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# 1 = autenticar (Brevo); 0 = sin autenticación (Mailpit).
SMTP_AUTH=1
# ssl | tls | none (vacío = deducir por puerto: 465→ssl, 587→tls, 1025→sin cifrado).
SMTP_SECURE=tls
SMTP_USER=CHANGE_ME@example.com
SMTP_PASSWORD=CHANGE_ME
# Remitente verificado en Brevo (no puede ser un email arbitrario).
SMTP_FROM_EMAIL=no-reply@tanish.example.com
SMTP_FROM_NAME=TANISH

# --- Cloudflare Worker ---
# ORIGIN_URL no se define aquí: se configura en el Worker con
# `wrangler secret put ORIGIN_URL` o una variable de entorno del dashboard.
# Debe ser la URL pública del WordPress (p. ej. https://tanish.example.com).
# Si queda vacía, el Worker responde 503 (no sirve una landing falsa).