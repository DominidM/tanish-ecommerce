# Copy to .env.production on the VPS and fill in real values.
# This file is intentionally not committed to the repository.

MYSQL_DATABASE=tanish_wordpress
MYSQL_USER=tanish_wp
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=0
WORDPRESS_URL=https://tanish.example.com

# Caddy
CADDY_DOMAIN=tanish.example.com
CADDY_EMAIL=admin@example.com

