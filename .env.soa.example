# ---------------------------------------------------------------------------
# Overlay SOA (Laravel) — variables adicionales sobre .env.production
# Copia este archivo a .env.soa y pásalo con --env-file.
# ---------------------------------------------------------------------------

# Dominio del panel Laravel (Caddy emite TLS automático)
CADDY_ADMIN_DOMAIN=admin.tanish.example.com
LARAVEL_URL=https://admin.tanish.example.com

# Clave generada con: php artisan key:generate --show
LARAVEL_APP_KEY=

# Base de datos exclusiva de Laravel (no comparte permisos con WordPress)
LARAVEL_DB_DATABASE=tanish_laravel
LARAVEL_DB_USERNAME=tanish_laravel
LARAVEL_DB_PASSWORD=cambia-esta-clave

# Credenciales de la REST API v3 de WooCommerce
WOOCOMMERCE_URL=http://wordpress:80
WOOCOMMERCE_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_WEBHOOK_SECRET=cambia-este-secreto

# Opcionales
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
WHATSAPP_NOTIFY_URL=
WHATSAPP_NOTIFY_TOKEN=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_DRIVER=webhook
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

TANISH_WHATSAPP_NUMBER=51975852932
TANISH_STORE_URL=http://wordpress:80
TANISH_ADMIN_EMAIL=tanish_admin@tanish.local
TANISH_ADMIN_USERNAME=tanish_admin
TANISH_ADMIN_PASSWORD=cambia-esta-clave
