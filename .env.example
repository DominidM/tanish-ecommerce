# TANISH E-Commerce - Variables de entorno (ejemplo)
# Copiar a .env y reemplazar CHANGE_ME por contraseñas seguras
# cp .env.example .env

# MySQL
MYSQL_DATABASE=tanish_wordpress
MYSQL_USER=tanish_wp
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# WordPress
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=tanish_wordpress
WORDPRESS_DB_USER=tanish_wp
WORDPRESS_DB_PASSWORD=CHANGE_ME

# WordPress - Opcional: prefijo de tablas y debug
# WORDPRESS_TABLE_PREFIX=wp_
# WORDPRESS_DEBUG=0
