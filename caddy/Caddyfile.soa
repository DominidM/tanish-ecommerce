{
  email {$CADDY_EMAIL}
  auto_https disable_redirects
}

# Tienda pública (WordPress + WooCommerce)
{$CADDY_DOMAIN} {
  encode gzip
  reverse_proxy wordpress:80
}

# Panel administrativo y API de integración (Laravel)
{$CADDY_ADMIN_DOMAIN} {
  encode gzip
  reverse_proxy laravel:80
}

# Ruta del Worker de Cloudflare (Cloudflare no permite fetch() a IPs directas,
# se usa nip.io como hostname que resuelve a la IP del VPS).
http://185.176.254.183.nip.io {
  encode gzip
  reverse_proxy wordpress:80 {
    header_up Host tanish-proxy.solvegrades.workers.dev
  }
}

:80 {
  respond 404
}
